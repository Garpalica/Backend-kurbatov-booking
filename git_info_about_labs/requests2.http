# Запросы для демонстрации. В VS Code нужно расширение REST Client, в JetBrains IDE всё встроено.
# Над каждым запросом появляется ссылка «Send Request».
# items заменить на свой ресурс, тела на поля своей сущности.

@base = http://localhost:8000/db

### Сервис жив?
GET {{base}}/health/

### Список
GET {{base}}/api/rooms/

### Получить одну запись
GET {{base}}/api/rooms/1

### Создать
POST {{base}}/api/rooms/
Content-Type: application/json

{ "name": "D998", "capacity": 10}


### Создание уже существующей комнаты ошибка 400
POST {{base}}/api/rooms/
Content-Type: application/json

{ "name": "D998", "capacity": 10 }


### Неизвестное поле ошибка 400
POST {{base}}/api/rooms/
Content-Type: application/json

{ "name": "D998", "capacity": 10 , "people":  10}


### Пустое обязательное поле, должен быть 400
POST {{base}}/api/rooms/
Content-Type: application/json

{ "name": "", "capacity": 10 }

### Неверное обязательное поле, должен быть 400
POST {{base}}/api/rooms/
Content-Type: application/json

{ "name": "B234", "capacity": -1 }

### Отсутствие обязательного поля, должен быть 400
POST {{base}}/api/rooms/
Content-Type: application/json

{ "capacity": 10 }

### Сломанный JSON, должен быть 400
POST {{base}}/api/rooms/
Content-Type: application/json

{ "name":

### Изменить
PATCH {{base}}/api/rooms/6
Content-Type: application/json

{ "name": "Изменённая запись","capacity": 2}

### Удалить
DELETE {{base}}/api/rooms/6

### После удаления должен быть 404
GET {{base}}/api/rooms/6

### Список пагинации
GET {{base}}/api/rooms/?limit=10&offset=0

### Список пагинации c фильтром
GET {{base}}/api/rooms/?limit=10&offset=0&is_booked=1

### Список пагинации c фильтром
GET {{base}}/api/rooms/?limit=10&offset=0&is_booked=1&capacity=50






